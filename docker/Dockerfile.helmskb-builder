# Toolchain used for the assistant backport; source and caches are mounted by
# the build invocation, so runtime credentials and data are never copied here.
FROM docker.m.daocloud.io/library/golang@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=public.ecr.aws/docker/library/rust:1.90-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f /usr/local/rustup /usr/local/rustup
COPY --from=public.ecr.aws/docker/library/rust:1.90-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f /usr/local/cargo/bin /usr/local/cargo/bin
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
ENV GOPROXY=https://proxy.golang.org,direct GOSUMDB=sum.golang.org GOMAXPROCS=2 GOFLAGS=-p=2 CARGO_BUILD_JOBS=2
WORKDIR /src
