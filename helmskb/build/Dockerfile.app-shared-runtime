# Reuse the freshly built parser's OS/dependency layers from the SAME upstream
# commit. Never supply a legacy parser or application image to this build.
ARG DOCREADER_IMAGE
FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS node-runtime
FROM ${DOCREADER_IMAGE}
ARG SOURCE_COMMIT
ARG UPSTREAM_COMMIT
ARG BRAND_HASH
ARG PACKAGING_COMMIT
LABEL org.opencontainers.image.title="HelmsKB" org.opencontainers.image.version="0.1.0-rc.1" org.opencontainers.image.revision=$SOURCE_COMMIT io.helmskb.upstream-revision=$UPSTREAM_COMMIT io.helmskb.brand-sha256=$BRAND_HASH io.helmskb.packaging-revision=$PACKAGING_COMMIT
USER root
WORKDIR /app
RUN --mount=type=cache,id=helmskb-shared-runtime-apt,target=/var/cache/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && (apt-get update || apt-get update) && \
    (attempt=0; until apt-get install -y --no-install-recommends build-essential postgresql-client default-mysql-client tzdata sed curl bash vim wget libsqlite3-0 python3-venv libffi-dev libssl-dev gosu ffmpeg qpdf; do attempt=$((attempt+1)); [ "$attempt" -lt 4 ] || exit 1; sleep 3; done) && \
    useradd -m -s /bin/bash appuser
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY runtime/migrate /usr/local/bin/migrate
COPY runtime/yanyiwu /go/pkg/mod/github.com/yanyiwu
COPY --chown=appuser:appuser runtime/duckdb /home/appuser/.duckdb
COPY --chown=appuser:appuser runtime/config ./config
COPY --chown=appuser:appuser runtime/scripts ./scripts
COPY --chown=appuser:appuser runtime/migrations ./migrations
COPY --chown=appuser:appuser runtime/dataset ./dataset
COPY --chown=appuser:appuser runtime/WeKnora ./WeKnora
COPY --chown=appuser:appuser runtime/helmskb-build.json ./helmskb-build.json
COPY --chown=appuser:appuser runtime/license-bundle/ ./
COPY browserskill/ /opt/weknora/browserskill/
RUN mkdir -p /data/files && chown appuser:appuser /data/files && chmod +x ./scripts/*.sh ./WeKnora
ENV VIRTUAL_ENV="" PATH="/home/appuser/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin" BROWSERSKILL_BINARY=/opt/weknora/browserskill/bsk BROWSERSKILL_EXTENSION_PATH=/opt/weknora/browserskill/browser-skill-weknora-0.3.1.zip
EXPOSE 8080
ENTRYPOINT ["./scripts/docker-entrypoint.sh"]
CMD ["./WeKnora"]
