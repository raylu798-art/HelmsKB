# Fresh OS runtime; Node comes from the pinned official image, avoiding hundreds
# of Debian npm helper packages while retaining the upstream Node/npm capability.
FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS node-runtime
FROM debian:12.12-slim@sha256:d5d3f9c23164ea16f31852f95bd5959aad1c5e854332fe00f7b3a20fcc9f635c
ARG SOURCE_COMMIT
ARG UPSTREAM_COMMIT
ARG BRAND_HASH
LABEL org.opencontainers.image.title="HelmsKB" org.opencontainers.image.version="0.1.0-rc.1" org.opencontainers.image.revision=$SOURCE_COMMIT io.helmskb.upstream-revision=$UPSTREAM_COMMIT io.helmskb.brand-sha256=$BRAND_HASH
WORKDIR /app
ARG HELMSKB_CACHE_PREFIX=helmskb
RUN --mount=type=cache,id=${HELMSKB_CACHE_PREFIX}-apt,target=/var/cache/apt,sharing=locked \
    useradd -m -s /bin/bash appuser && rm -f /etc/apt/apt.conf.d/docker-clean && \
    printf 'Acquire::Retries "5";\n' > /etc/apt/apt.conf.d/80helmskb && \
    (apt-get update || apt-get update) && \
    (attempt=0; until apt-get install -y --no-install-recommends ca-certificates build-essential postgresql-client default-mysql-client tzdata sed curl bash vim wget libsqlite3-0 python3 python3-pip python3-venv python3-dev libffi-dev libssl-dev gosu ffmpeg qpdf; do attempt=$((attempt+1)); [ "$attempt" -lt 4 ] || exit 1; sleep 3; done) && \
    python3 -m pip install --break-system-packages --upgrade pip setuptools wheel && \
    mkdir -p /home/appuser/.local/bin && curl -LsSf https://astral.sh/uv/install.sh | CARGO_HOME=/home/appuser/.cargo UV_INSTALL_DIR=/home/appuser/.local/bin sh && \
    ln -sf /home/appuser/.local/bin/uvx /usr/local/bin/uvx && chmod +x /usr/local/bin/uvx && rm -rf /var/lib/apt/lists/*
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY runtime/migrate /usr/local/bin/migrate
COPY runtime/yanyiwu /go/pkg/mod/github.com/yanyiwu
COPY runtime/duckdb /home/appuser/.duckdb
COPY runtime/config ./config
COPY runtime/scripts ./scripts
COPY runtime/migrations ./migrations
COPY runtime/dataset ./dataset
COPY runtime/WeKnora ./WeKnora
COPY runtime/helmskb-build.json ./helmskb-build.json
COPY runtime/license-bundle/ ./
COPY browserskill/ /opt/weknora/browserskill/
RUN mkdir -p /data/files && chown -R appuser:appuser /app /data/files /home/appuser && chmod +x ./scripts/*.sh ./WeKnora
ENV BROWSERSKILL_BINARY=/opt/weknora/browserskill/bsk BROWSERSKILL_EXTENSION_PATH=/opt/weknora/browserskill/browser-skill-weknora-0.3.1.zip
EXPOSE 8080
ENTRYPOINT ["./scripts/docker-entrypoint.sh"]
CMD ["./WeKnora"]
