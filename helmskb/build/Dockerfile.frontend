FROM nginx:1.30.3-alpine@sha256:0d3b80406a13a767339fbe2f41406d6c7da727ab89cf8fae399e81f780f814d1
ARG SOURCE_COMMIT
ARG UPSTREAM_COMMIT
ARG BRAND_HASH
LABEL org.opencontainers.image.title="HelmsKB" org.opencontainers.image.version="0.1.0-rc.1" org.opencontainers.image.revision=$SOURCE_COMMIT io.helmskb.upstream-revision=$UPSTREAM_COMMIT io.helmskb.brand-sha256=$BRAND_HASH
COPY frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/templates/default.conf.template
COPY frontend/nginx-api-proxy.conf /etc/nginx/api-proxy.conf
COPY frontend/nginx-http.conf /etc/nginx/conf.d/00-weknora-http.conf
COPY frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh && test -f /usr/share/nginx/html/docs/index.html
ENV MAX_FILE_SIZE_MB=50
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
